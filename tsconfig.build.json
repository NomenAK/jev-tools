{
  // Emits plain JavaScript for the binaries only (MCP server and jev-check).
  // Node refuses to strip TypeScript types for files under node_modules, so an
  // installed package cannot run src/mcp/main.ts directly. pi and omp keep
  // loading src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": [],
  "files": ["src/mcp/main.ts", "src/cli/check.ts"]
}
